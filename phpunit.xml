<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
            APP_URL fixa para os testes. Sem isto, a suíte herda a do ambiente
            e muda de resultado conforme a máquina: o mesmo commit passava no
            localhost e reprovava no staging, onde a APP_URL é o endereço
            Tailscale. Teste que depende de onde roda não é portão, é sorteio.
        -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <!--
            A suíte não escreve no log de verdade. O portão do staging roda os
            testes na versão que vai subir, e o vigia de logs lê esse mesmo
            arquivo: os erros que os testes provocam de propósito (T-412)
            virariam Bug no quadro a cada publicação. Quem confere log usa
            Log::spy, que não depende do canal.
        -->
        <env name="LOG_CHANNEL" value="null"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- O monitor parte de "não configurado" nos testes: o staging roda a suíte
             com o .env de verdade, e o endereço de lá vazava para os testes que
             conferem justamente o caso sem endereço (T-394). Quem precisa dele
             liga com config() no próprio teste. -->
        <env name="ALFAMONITOR_URL" value=""/>
        <env name="ALFAMONITOR_API_URL" value=""/>
        <env name="ALFAMONITOR_API_TOKEN" value=""/>
    </php>
</phpunit>
