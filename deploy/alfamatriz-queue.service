[Unit]
# Executor da fila do AlfaMatriz.
#
# A fila já estava configurada (QUEUE_CONNECTION=database, tabela jobs), mas
# ninguém a consumia: tudo que fosse enfileirado ficaria parado para sempre.
# Sem este serviço, um botão que enfileira trabalho mente para quem clicou.
Description=AlfaMatriz — executor da fila
After=network.target mariadb.service
Wants=mariadb.service

[Service]
# Mesmo usuário do PHP-FPM: é o que garante que os arquivos criados em
# storage/ continuem legíveis pelo painel (ver o bloco de permissões em
# deploy/provisionar.sh).
User=www-data
Group=www-data
WorkingDirectory=/var/www/alfamatriz

# --max-time recicla o processo de hora em hora. Sem isso, um executor que
# subiu antes de uma publicação continuaria rodando o código velho até alguém
# reparar — e `queue:restart` só é notado entre um trabalho e outro.
ExecStart=/usr/bin/php /var/www/alfamatriz/artisan queue:work database \
    --sleep=3 --tries=3 --backoff=60 --max-time=3600

# O executor sai de propósito ao reciclar, ao receber `queue:restart` e ao
# perder o banco: em todos esses casos o certo é subir de novo, não ficar fora.
Restart=always
RestartSec=5

StandardOutput=append:/var/log/alfamatriz-queue.log
StandardError=append:/var/log/alfamatriz-queue.log

[Install]
WantedBy=multi-user.target
