# Runner da Central de IA como serviço do usuário (systemd --user).
# Instalação: deploy/central-ia/README.md. Roda com o HOME, os logins de IA e
# os projetos da própria pessoa — nunca como root, nunca em container.
[Unit]
Description=Runner da Central de IA (AlfaMatriz)
After=network-online.target

[Service]
ExecStart=/usr/bin/env node %h/.local/share/alfa/central-ia-runner.mjs
Restart=always
RestartSec=10
# Na parada o runner encerra os agentes e reporta "interrompida" ao
# AlfaMatriz; isso leva segundos, não o teto de 15 min da execução.
TimeoutStopSec=60
KillMode=mixed
# O PATH do systemd não traz o ~/.local/bin (onde o Copilot se instala).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
