# Bot do Telegram da Central de IA, no servidor do AlfaMatriz.
#
# Instalar (uma vez, como root), depois do primeiro deploy com a Central:
#   cp deploy/central-ia/alfamatriz-central-ia-telegram.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now alfamatriz-central-ia-telegram
#
# - Roda a partir de atual/: o deploy/publicar.sh o reinicia depois de cada
#   troca de versão (processo longo não vê código novo sozinho).
# - Ouve o bot de CADA pessoa (T-374), cadastrado nos Ajustes da Central e
#   marcado com o APP_URL deste servidor; sem bot nenhum, fica de pé e espera.
#   O Telegram aceita UM leitor por bot: o mesmo bot não pode estar cadastrado
#   em dois ambientes ao mesmo tempo.
# - Precisa de saída para api.telegram.org.
[Unit]
Description=Central de IA — bot do Telegram (AlfaMatriz)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/alfamatriz/atual
ExecStart=/usr/bin/php artisan central-ia:telegram
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
