# Ambiente do agente (systemd lê este arquivo; ele mora em /etc/alfa-agente.env, com chmod 600).
# Nenhum destes valores é versionado — este é o exemplo.

# O bot do Telegram (@rossini_server_bot, o mesmo do changelog). Sai do chaveiro do macOS.
TELEGRAM_TOKEN=

# Quem pode comandar: ids numéricos do Telegram, separados por vírgula. Mande qualquer
# mensagem ao bot com isto vazio e ele responde o seu id.
TELEGRAM_PERMITIDOS=

# Como o agente chama quem comanda, na frase que explica o papel dele.
AGENTE_DONO=Rossini

# O token do servidor MCP de produção (php artisan alfa:mcp-token <email> --nome=lxc-dev, rodado em produção).
# O .mcp.json do clone lê esta variável para a entrada "alfamatriz-producao". Entre aspas: ele tem um "|".
ALFAMATRIZ_MCP_TOKEN=""

# Um .mcp.json só desta máquina, usado no lugar do do repositório. Necessário no LXC 108, que não
# alcança a produção pela tailnet — só por http://10.0.3.115/mcp na rede interna do Proxmox.
# Exemplo em /etc/alfa-agente-mcp.json:
#   {"mcpServers":{"alfamatriz-producao":{"type":"http","url":"http://10.0.3.115/mcp","headers":{"Authorization":"Bearer <token>"}}}}
AGENTE_MCP_CONFIG=/etc/alfa-agente-mcp.json

# A oficina: uma pasta com um clone por sistema, onde o agente de código trabalha. O CLAUDE.md dela é
# cópia de deploy/agente/oficina-CLAUDE.md. Sem ela, o agente só enxerga o AGENTE_REPO.
# AGENTE_OFICINA=/Users/agente/sistemas

# Opcionais (os padrões servem):
# AGENTE_REPO=/opt/dev/AlfaMatriz
# AGENTE_ESTADO=/var/lib/alfa-agente/estado.json
# AGENTE_CLAUDE=/root/.local/bin/claude
# AGENTE_TEMPO_MAXIMO_MIN=240
# AGENTE_QUADRO=<pasta do estado>/quadro   (onde roda a faixa do quadro; só vale com AGENTE_MCP_CONFIG)
# Transcrição de áudio na própria máquina (Whisper via faster-whisper, em /opt/whisper).
# Vazio, a ponte responde que não entende áudio. Ver README para a instalação.
AGENTE_TRANSCRITOR=/opt/dev/AlfaMatriz/deploy/agente/transcrever.py
# AGENTE_AUDIO=/var/lib/alfa-agente/audio
# Mantém o transcritor aberto, com o modelo na memória (~1 GB): 1 s por áudio em vez de 3. Só onde há RAM (Mac).
# AGENTE_TRANSCRITOR_RESIDENTE=1
# WHISPER_VOCABULARIO="nomes próprios que o Whisper deve reconhecer"   (padrão em transcrever.py)

# O Claude Code recusa `--dangerously-skip-permissions` como root, a menos que o ambiente se declare
# isolado. O LXC é um contêiner: é exatamente o caso que a variável existe para cobrir.
IS_SANDBOX=1
TZ=America/Sao_Paulo
