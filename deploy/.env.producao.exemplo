# Modelo do ambiente publicado do AlfaMatriz (container alfamatriz, LXC 115).
#
# Copie para /var/www/alfamatriz/.env no servidor e preencha o que está
# marcado como PREENCHER. Este arquivo é versionado: NUNCA guarde segredo real
# aqui.

APP_NAME=AlfaMatriz
APP_ENV=production
# Gere no servidor: php artisan key:generate
APP_KEY=PREENCHER
APP_DEBUG=false
APP_URL=https://matriz.alfasolucoes.cloud

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Em produção o log não guarda debug: as mensagens carregam dado do negócio.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB local do próprio container.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alfamatriz
DB_USERNAME=alfamatriz
DB_PASSWORD=PREENCHER

# Conta de administrador criada pela carga inicial.
# O e-mail precisa bater com o acesso em uso: se ele mudar e esta variável
# ficar para trás, um `db:seed` recria a conta antiga.
ADMIN_EMAIL=PREENCHER
# Sem a senha, o seeder falha de propósito — a de exemplo do README é pública.
ADMIN_PASSWORD=PREENCHER

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# O painel só existe em HTTPS (Funnel): o cookie não pode trafegar em claro.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# E-mail — Google Workspace por SMTP.
#
# MAIL_PASSWORD é uma SENHA DE APLICATIVO (myaccount.google.com/apppasswords),
# não a senha da conta: com verificação em duas etapas ligada, a senha da conta
# é recusada. A porta 587 usa STARTTLS; se ela estiver bloqueada na saída do
# container, o plano B é MAIL_SCHEME=smtps na porta 465.
#
# Depois de preencher, confira com: php artisan app:testar-email seu@email
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=painel@alfatecnologia.com.br
MAIL_PASSWORD=PREENCHER
MAIL_FROM_ADDRESS="painel@alfatecnologia.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Hostinger — token da conta, para acompanhar vencimento de hospedagem.
# Sem ele a sincronização fica desligada e o cadastro manual continua valendo.
HOSTINGER_API_TOKEN=PREENCHER

VITE_APP_NAME="${APP_NAME}"
